{
  "entities": {
    "Service": {
      "title": "Service Package",
      "description": "Available freelance service packages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique service ID" },
        "title": { "type": "string", "maxLength": 100, "description": "Service package title" },
        "category": { "type": "string", "enum": ["web", "mobile", "ai", "3d", "backend", "fullstack"] },
        "shortDescription": { "type": "string", "maxLength": 300 },
        "fullDescription": { "type": "string", "maxLength": 2000 },
        "basePrice": { "type": "number" },
        "turnaroundDays": { "type": "number" },
        "features": { "type": "array" },
        "threeGeometry": { "type": "string" },
        "color": { "type": "string" },
        "popular": { "type": "boolean" }
      },
      "required": ["id", "title", "category", "basePrice", "turnaroundDays"]
    },
    "Order": {
      "title": "Client Order",
      "description": "Client service orders and delivery status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientEmail": { "type": "string", "maxLength": 150 },
        "companyName": { "type": "string", "maxLength": 100 },
        "serviceId": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "category": { "type": "string" },
        "budget": { "type": "number" },
        "deadline": { "type": "string" },
        "requirements": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "in_progress", "review", "completed", "cancelled"] },
        "progressPercent": { "type": "number" },
        "deliverableUrl": { "type": "string" },
        "privateNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "clientName", "clientEmail", "serviceId", "serviceTitle", "budget", "requirements", "status"]
    },
    "OrderMessage": {
      "title": "Order Communication Message",
      "description": "Messages exchanged between client and freelancer for an order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "sender": { "type": "string", "enum": ["client", "freelancer", "system"] },
        "senderName": { "type": "string" },
        "text": { "type": "string", "maxLength": 3000 },
        "attachments": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderId", "sender", "senderName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Collection of available service offerings"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of client orders"
    },
    "/order_messages/{messageId}": {
      "schema": "OrderMessage",
      "description": "Messages linked to order communications"
    }
  }
}
